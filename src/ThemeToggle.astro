---
// The theme toggle: a native `<details>` dropdown with light / gray / dark
// rows — the port of `dioxus_chrome::ThemeToggle`. The active-theme summary
// glyph is CSS-swapped (`.ic-moon` / `.ic-gray` / `.ic-sun`, keyed on
// `<html>.dark` / `.gray` — see styles/theme.css); open/close is native, so it
// works on a first paint with no script. `name="dx-nav-popover"` groups it
// with the locale dropdown as an exclusive accordion: opening one closes the
// other. The ids are theme.css's contract and must not drift.
import type { Labels } from "./labels.ts";

interface Props {
  labels: Labels;
  class?: string;
}
const { labels, class: cls = "relative ml-2 group" } = Astro.props;

const ROW =
  "flex w-full items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 no-underline cursor-pointer";
const SUN =
  "M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z";
const MOON = "M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z";
---

<details id="theme-details" name="dx-nav-popover" class={cls}>
  <summary
    class="list-none inline-flex items-center cursor-pointer select-none text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg text-sm p-2.5"
    aria-label={labels.theme}
    title={labels.theme}
  >
    <svg class="ic-moon w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
      <path d={MOON}></path>
    </svg>
    <svg class="ic-gray w-5 h-5" aria-hidden="true" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
      <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="M10 2a8 8 0 010 16z" fill="currentColor"></path>
    </svg>
    <svg class="ic-sun w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
      <path fill-rule="evenodd" clip-rule="evenodd" d={SUN}></path>
    </svg>
  </summary>
  <div
    id="theme-menu"
    class="absolute right-0 mt-1 w-36 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-lg py-1 z-30"
  >
    <button type="button" data-theme="light" class:list={["opt-light", ROW]}>
      <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d={SUN}></path>
      </svg>
      <span>{labels.light}</span>
    </button>
    <button type="button" data-theme="gray" class:list={["opt-gray", ROW]}>
      <svg class="w-5 h-5" aria-hidden="true" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="M10 2a8 8 0 010 16z" fill="currentColor"></path>
      </svg>
      <span>{labels.gray}</span>
    </button>
    <button type="button" data-theme="dark" class:list={["opt-dark", ROW]}>
      <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path d={MOON}></path>
      </svg>
      <span>{labels.dark}</span>
    </button>
  </div>
</details>

<script>
  // Exactly what `dioxus_chrome::ThemeOption`'s eval did on click: the two
  // classes on <html>, `color-scheme`, the `color-theme` key, the theme-color
  // meta, and close the menu. The pre-paint script in Layout.astro reads the
  // key back on the next page.
  import { BAR, THEME_KEY } from "./theme.ts";
  for (const row of document.querySelectorAll<HTMLButtonElement>("#theme-menu button[data-theme]")) {
    row.addEventListener("click", () => {
      const t = (row.dataset.theme ?? "light") as keyof typeof BAR;
      const el = document.documentElement;
      el.classList.toggle("dark", t === "dark");
      el.classList.toggle("gray", t === "gray");
      el.style.colorScheme = t === "dark" ? "dark" : "light";
      localStorage.setItem(THEME_KEY, t);
      let m = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      if (!m) {
        m = document.createElement("meta");
        m.name = "theme-color";
        document.head.appendChild(m);
      }
      m.content = BAR[t] ?? BAR.light;
      const d = document.getElementById("theme-details") as HTMLDetailsElement | null;
      if (d) d.open = false;
    });
  }
</script>
