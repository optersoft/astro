---
// The branded 404 body: a mono code, a heading, a sentence, one or two
// buttons. Rendered inside a site's own Layout + Shell, so it is its 404 with
// its header and footer — Astro writes the page to `dist/404.html`, which
// Cloudflare Pages serves with a real 404 status for any unmatched path.
interface Props {
  code?: string;
  heading: string;
  body: string;
  home: { href: string; label: string };
  other?: { href: string; label: string };
}
const { code = "404", heading, body, home, other } = Astro.props;
---

<div class="flex min-h-[60vh] flex-col items-center justify-center px-5 py-20 text-center sm:px-6">
  <p class="font-mono text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">{code}</p>
  <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">{heading}</h1>
  <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">{body}</p>
  <div class="mt-10 flex flex-col gap-3 sm:flex-row">
    <a
      href={home.href}
      class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-blue-500"
    >
      {home.label}
    </a>
    {
      other && (
        <a
          href={other.href}
          class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-6 py-3 text-base font-semibold text-slate-900 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-white dark:hover:bg-slate-800"
        >
          {other.label}
        </a>
      )
    }
  </div>
</div>
